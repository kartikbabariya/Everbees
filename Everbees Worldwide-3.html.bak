"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n\n\n\n\n\n\n\n<script src=\"b72e31b8-d4f7-4824-9caa-896c28fe2317\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<title>Everbees Worldwide | Import, Export &amp; Global Sourcing — Surat, India<\u002Ftitle>\n<meta name=\"description\" content=\"Everbees Worldwide Pvt. Ltd. — registered import–export and global sourcing company in Surat. LCL &amp; FCL shipments, verified factory-direct suppliers, customs clearance and logistics at the best landed price.\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"theme-color\" content=\"#0A1530\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"64x64\" href=\"60c69c2a-68e7-46e5-b181-36233ee0c567\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"d8bc4b95-23c3-4fcf-8ee8-e37fd30e114b\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"Everbees Worldwide\">\n<meta property=\"og:title\" content=\"Everbees Worldwide — Import, Export &amp; Global Sourcing\">\n<meta property=\"og:description\" content=\"Registered import–export company in Surat, India. Verified supplier network, LCL &amp; FCL shipments, customs clearance and end-to-end logistics.\">\n<meta property=\"og:image\" content=\"https://darling-kelpie-dc64a8.netlify.app/assets/og-image.jpg\">\n<meta property=\"og:url\" content=\"https://darling-kelpie-dc64a8.netlify.app/\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\">\n<style>/* cyrillic-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"edcd182b-b4fd-4856-b593-623bb290799c\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"77adb86a-15d6-4017-9994-347b264c7074\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"1f34a6a4-17b6-4a62-80c2-9445aad16d43\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"a4f15fca-152c-4fcc-a403-2d4c63ed3034\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"edcd182b-b4fd-4856-b593-623bb290799c\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"77adb86a-15d6-4017-9994-347b264c7074\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"1f34a6a4-17b6-4a62-80c2-9445aad16d43\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"a4f15fca-152c-4fcc-a403-2d4c63ed3034\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"edcd182b-b4fd-4856-b593-623bb290799c\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"77adb86a-15d6-4017-9994-347b264c7074\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"1f34a6a4-17b6-4a62-80c2-9445aad16d43\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Plus Jakarta Sans';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"a4f15fca-152c-4fcc-a403-2d4c63ed3034\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  *, *::before, *::after { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body { margin: 0; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #2B3450; background: #0A1530; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }\n  a { color: #B8892B; text-decoration: none; transition: color .2s, background-color .2s, border-color .2s, transform .2s; }\n  a:hover { color: #8F6A1C; }\n  ::selection { background: #E0B45A; color: #0A1530; }\n  input, textarea, select, button { font-family: inherit; font-size: inherit; }\n  input::placeholder, textarea::placeholder { color: #8F96AC; }\n  img { max-width: 100%; }\n  @keyframes ebRise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }\n  @keyframes ebFade { from { opacity: 0; } to { opacity: 1; } }\n  @keyframes ebTicker { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n  @keyframes ebPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(61,169,53,.55); } 70% { box-shadow: 0 0 0 9px rgba(61,169,53,0); } }\n  @keyframes ebPulseGold { 0%, 100% { box-shadow: 0 0 0 0 rgba(224,180,90,.6); } 70% { box-shadow: 0 0 0 9px rgba(224,180,90,0); } }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"min-height:100vh;background:#0A1530;overflow-x:clip\">\n\n  <header style=\"position:sticky;top:0;z-index:60;background:rgba(10,21,48,.82);backdrop-filter:blur(16px);border-bottom:1px solid rgba(244,239,230,.12)\">\n    <div style=\"max-width:1320px;margin:0 auto;padding:0 clamp(20px,5vw,72px);height:clamp(70px,7vw,88px);display:flex;align-items:center;justify-content:space-between;gap:24px\">\n      <a href=\"#home\" sc-camel-on-click=\"{{ goHome }}\" style=\"display:flex;align-items:center;gap:14px;flex:none\">\n        <img src=\"864cc7e7-fb3a-4007-98f7-dec288b277b4\" alt=\"Everbees Worldwide\" style=\"height:clamp(36px,3.4vw,44px);width:auto;display:block\">\n        <span style=\"display:flex;flex-direction:column;gap:4px\">\n          <span style=\"font-weight:800;font-size:clamp(13px,1.2vw,15px);letter-spacing:.24em;color:#F4EFE6;line-height:1\">EVERBEES<\u002Fspan>\n          <span style=\"font-weight:600;font-size:clamp(8px,.8vw,9.5px);letter-spacing:.36em;color:#E0B45A;line-height:1\">WORLDWIDE<\u002Fspan>\n        <\u002Fspan>\n      <\u002Fa>\n\n      <sc-if value=\"{{ isDesktop }}\" hint-placeholder-val=\"{{ true }}\">\n        <nav style=\"display:flex;align-items:center;gap:clamp(18px,2.4vw,36px)\">\n          <sc-for list=\"{{ nav }}\" as=\"item\" hint-placeholder-count=\"6\">\n            <a href=\"{{ item.href }}\" sc-camel-on-click=\"{{ item.go }}\" style=\"display:flex;align-items:center;gap:8px;font-size:14px;font-weight:500;letter-spacing:0;white-space:nowrap;padding:6px 0;color:{{ item.color }}\" style-hover=\"color:#E0B45A\">\n              <span style=\"width:5px;height:5px;border-radius:50%;background:#E0B45A;flex:none;opacity:{{ item.dot }}\"><\u002Fspan>\n              {{ item.label }}\n            <\u002Fa>\n          <\u002Fsc-for>\n          <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"display:inline-flex;align-items:center;background:#F4EFE6;color:#0A1530;padding:13px 22px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#E0B45A;color:#0A1530\">Get a Quote<\u002Fa>\n        <\u002Fnav>\n      <\u002Fsc-if>\n\n      <sc-if value=\"{{ isMobile }}\">\n        <button sc-camel-on-click=\"{{ toggleMenu }}\" aria-label=\"Open menu\" style=\"width:48px;height:48px;border:1px solid rgba(244,239,230,.25);background:transparent;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;flex:none\">\n          <span style=\"width:20px;height:1.5px;background:#F4EFE6\"><\u002Fspan>\n          <span style=\"width:20px;height:1.5px;background:#F4EFE6\"><\u002Fspan>\n        <\u002Fbutton>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n  <\u002Fheader>\n\n  <sc-if value=\"{{ menuOpen }}\">\n    <div style=\"position:fixed;inset:0;z-index:100;background:#0A1530;display:flex;flex-direction:column;padding:clamp(20px,5vw,40px);animation:ebFade .22s ease both;overflow:auto\">\n      <div style=\"display:flex;align-items:center;justify-content:space-between\">\n        <span style=\"display:flex;align-items:center;gap:12px\">\n          <img src=\"864cc7e7-fb3a-4007-98f7-dec288b277b4\" alt=\"\" style=\"height:34px;width:auto;display:block\">\n          <span style=\"font-weight:800;font-size:13px;letter-spacing:.24em;color:#F4EFE6\">EVERBEES<\u002Fspan>\n        <\u002Fspan>\n        <button sc-camel-on-click=\"{{ toggleMenu }}\" aria-label=\"Close menu\" style=\"width:48px;height:48px;border:1px solid rgba(244,239,230,.25);background:transparent;border-radius:50%;color:#F4EFE6;font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center\">×<\u002Fbutton>\n      <\u002Fdiv>\n      <nav style=\"display:grid;gap:4px;margin:auto 0;padding:40px 0\">\n        <sc-for list=\"{{ nav }}\" as=\"item\" hint-placeholder-count=\"6\">\n          <a href=\"{{ item.href }}\" sc-camel-on-click=\"{{ item.go }}\" style=\"display:flex;align-items:baseline;gap:18px;padding:12px 0;border-bottom:1px solid rgba(244,239,230,.1);font-weight:500;font-size:clamp(26px,6.4vw,38px);line-height:1.15;color:{{ item.color }}\">\n            <span style=\"font-family:'Plus Jakarta Sans',sans-serif;font-size:11px;font-weight:700;letter-spacing:.2em;color:#E0B45A\">{{ item.num }}<\u002Fspan>\n            {{ item.label }}\n          <\u002Fa>\n        <\u002Fsc-for>\n      <\u002Fnav>\n      <div style=\"display:grid;gap:14px\">\n        <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;justify-content:center;gap:10px;background:#1B7F35;color:#F4EFE6;padding:17px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"background:#156A2B;color:#F4EFE6\">WhatsApp Us<\u002Fa>\n        <a href=\"tel:+919099031705\" style=\"display:flex;align-items:center;justify-content:center;border:1px solid rgba(244,239,230,.3);color:#F4EFE6;padding:17px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"border-color:#E0B45A;color:#E0B45A\">+91 90990 31705<\u002Fa>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isHome }}\" hint-placeholder-val=\"{{ true }}\">\n  <main data-screen-label=\"Home\" style=\"animation:ebFade .4s ease both\">\n\n    <section style=\"position:relative;background:#0A1530;overflow:hidden\">\n      <div style=\"position:absolute;top:-20%;right:-8%;width:min(760px,70vw);height:min(760px,70vw);border-radius:50%;background:radial-gradient(circle,rgba(184,137,43,.34),rgba(10,21,48,0) 66%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px) clamp(64px,7vw,110px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(460px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center\">\n        <div style=\"animation:ebRise .8s cubic-bezier(.2,.7,.2,1) both\">\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:28px\">\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62)\">Import &nbsp;•&nbsp; Export &nbsp;•&nbsp; Global Sourcing &nbsp;•&nbsp; Logistics<\u002Fspan>\n          <\u002Fdiv>\n          <h1 style=\"font-weight:500;font-size:clamp(38px,5vw,76px);line-height:1.04;letter-spacing:-.035em;color:#F4EFE6;margin:0 0 30px;text-wrap:balance\">Connecting India <em style=\"font-style:normal;color:#E0B45A\">with the world.<\u002Fem><\u002Fh1>\n          <p style=\"font-size:clamp(16px,1.25vw,19px);line-height:1.7;color:rgba(244,239,230,.74);margin:0 0 40px;max-width:54ch;text-wrap:pretty\">Everbees Worldwide connects India with the world, importing and exporting quality products with seamless logistics, at the most competitive prices.<\u002Fp>\n          <div style=\"display:flex;flex-wrap:wrap;gap:14px;align-items:center\">\n            <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"display:inline-flex;align-items:center;background:#F4EFE6;color:#0A1530;padding:18px 32px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#E0B45A;color:#0A1530\">Get a Quote<\u002Fa>\n            <a href=\"#services\" sc-camel-on-click=\"{{ goServices }}\" style=\"display:inline-flex;align-items:center;border:1px solid rgba(244,239,230,.32);color:#F4EFE6;padding:18px 32px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"border-color:#E0B45A;color:#E0B45A\">Our Services<\u002Fa>\n            <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;gap:10px;color:#F4EFE6;padding:18px 8px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"color:#E0B45A\">\n              <span style=\"width:9px;height:9px;border-radius:50%;background:#3DA935;animation:ebPulse 2.2s ease-out infinite;flex:none\"><\u002Fspan>\n              WhatsApp\n            <\u002Fa>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"position:relative;width:100%;max-width:620px;margin:0 auto;animation:ebRise .9s .15s cubic-bezier(.2,.7,.2,1) both\">\n          <div style=\"position:relative;aspect-ratio:1;touch-action:pan-y;cursor:grab;user-select:none\" style-active=\"cursor:grabbing\">\n            <div ref=\"{{ globeRef }}\" role=\"img\" aria-label=\"Rotating globe with trade routes radiating from Surat, India\" style=\"position:absolute;inset:0\"><\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding:14px 4px 0;border-top:1px solid rgba(244,239,230,.12)\">\n            <span style=\"display:flex;flex-direction:column;gap:6px\">\n              <span style=\"font-weight:500;font-size:24px;line-height:1;color:#F4EFE6\">Surat, India<\u002Fspan>\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62)\">21.17° N | 72.83° E<\u002Fspan>\n            <\u002Fspan>\n            <span style=\"display:flex;flex-direction:column;align-items:flex-end;gap:6px;text-align:right\">\n              <span style=\"display:flex;align-items:center;gap:10px;font-size:10.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(244,239,230,.8)\"><span style=\"width:7px;height:7px;border-radius:50%;background:#E0B45A;animation:ebPulseGold 2.2s ease-out infinite;flex:none\"><\u002Fspan>Import | Export routes<\u002Fspan>\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.45)\">Drag to rotate<\u002Fspan>\n            <\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"position:relative;border-top:1px solid rgba(244,239,230,.14);border-bottom:1px solid rgba(244,239,230,.14);overflow:hidden;background:rgba(10,21,48,.6)\">\n        <div style=\"display:flex;width:max-content;animation:ebTicker 46s linear infinite\" style-hover=\"animation-play-state:paused\">\n          <sc-for list=\"{{ trust }}\" as=\"t\" hint-placeholder-count=\"6\">\n            <span style=\"display:flex;align-items:center;gap:22px;padding:18px 30px;white-space:nowrap;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:rgba(244,239,230,.86)\">\n              <span style=\"width:7px;height:7px;background:#E0B45A;transform:rotate(45deg);flex:none\"><\u002Fspan>\n              {{ t.label }}\n            <\u002Fspan>\n          <\u002Fsc-for>\n          <sc-for list=\"{{ trust }}\" as=\"t\" hint-placeholder-count=\"6\">\n            <span style=\"display:flex;align-items:center;gap:22px;padding:18px 30px;white-space:nowrap;font-size:12px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:rgba(244,239,230,.86)\">\n              <span style=\"width:7px;height:7px;background:#E0B45A;transform:rotate(45deg);flex:none\"><\u002Fspan>\n              {{ t.label }}\n            <\u002Fspan>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(36px,5vw,80px);align-items:start\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n            <span style=\"font-weight:500;font-size:19px;color:#8F6A1C\">01<\u002Fspan>\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Who we are<\u002Fspan>\n          <\u002Fdiv>\n          <h2 style=\"font-weight:500;font-size:clamp(26px,3.1vw,42px);line-height:1.12;letter-spacing:-.03em;color:#0F1730;margin:0;text-wrap:balance\">With 80+ successful shipments and a growing global client base, Everbees Worldwide delivers <em style=\"font-style:normal;color:#B8892B\">end-to-end<\u002Fem> international trade solutions.<\u002Fh2>\n        <\u002Fdiv>\n        <div style=\"padding-top:clamp(0px,3vw,58px)\">\n          <p style=\"font-size:clamp(16px,1.25vw,19px);line-height:1.75;color:#2B3450;margin:0 0 22px;text-wrap:pretty\">From sourcing and freight to customs clearance and doorstep delivery, we handle it all, so you get the best products at the best price, on time, every time.<\u002Fp>\n          <p style=\"font-size:16px;line-height:1.75;color:#5A6178;margin:0 0 34px;text-wrap:pretty\">As a registered private limited company, we work only with genuine, factory-direct suppliers. Every order is handled with full documentation and complete transparency: whether it is a single LCL consignment or a full container.<\u002Fp>\n          <a href=\"#about\" sc-camel-on-click=\"{{ goAbout }}\" style=\"display:inline-flex;align-items:center;gap:12px;font-weight:600;font-size:14px;letter-spacing:0;color:#0F1730\" style-hover=\"color:#8F6A1C\">About the company <span style=\"font-weight:500;font-size:20px;line-height:1\">→<\u002Fspan><\u002Fa>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6;border-top:1px solid rgba(15,23,48,.1)\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)\">\n        <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n          <span style=\"font-weight:500;font-size:19px;color:#8F6A1C\">02<\u002Fspan>\n          <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Two-way trade<\u002Fspan>\n        <\u002Fdiv>\n        <h2 style=\"font-weight:500;font-size:clamp(28px,3.4vw,46px);line-height:1.1;letter-spacing:-.03em;color:#0F1730;margin:0 0 clamp(36px,4vw,56px);max-width:22ch;text-wrap:balance\">Both sides of international trade, <em style=\"font-style:normal;color:#B8892B\">one partner.<\u002Fem><\u002Fh2>\n\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:clamp(16px,2vw,28px)\">\n          <div style=\"background:#0A1530;border-radius:6px;padding:clamp(30px,3.6vw,52px);display:flex;flex-direction:column;gap:22px;position:relative;overflow:hidden\">\n            <div style=\"position:absolute;right:-10%;top:-30%;width:60%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(184,137,43,.28),rgba(10,21,48,0) 68%);pointer-events:none\"><\u002Fdiv>\n            <div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px\">\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62)\">World → India<\u002Fspan>\n              <span style=\"font-weight:500;font-size:19px;color:rgba(244,239,230,.5)\">Inbound<\u002Fspan>\n            <\u002Fdiv>\n            <h3 style=\"font-weight:500;font-size:clamp(34px,4vw,56px);line-height:1.04;letter-spacing:-.035em;color:#F4EFE6;margin:0\">Import<\u002Fh3>\n            <p style=\"font-size:16px;line-height:1.72;color:rgba(244,239,230,.74);margin:0;text-wrap:pretty\">We source and bring in quality products from global manufacturers. Supplier sourcing, order placement, freight booking, customs clearance and delivery, all managed by one team.<\u002Fp>\n            <div style=\"display:grid;gap:12px;border-top:1px solid rgba(244,239,230,.14);padding-top:22px;margin-top:auto\">\n              <span style=\"display:flex;gap:14px;align-items:baseline;font-size:14.5px;color:#F4EFE6\"><span style=\"width:6px;height:6px;background:#E0B45A;transform:rotate(45deg);flex:none\"><\u002Fspan>Sourcing &amp; procurement from verified factories<\u002Fspan>\n              <span style=\"display:flex;gap:14px;align-items:baseline;font-size:14.5px;color:#F4EFE6\"><span style=\"width:6px;height:6px;background:#E0B45A;transform:rotate(45deg);flex:none\"><\u002Fspan>Sea freight: LCL &amp; FCL<\u002Fspan>\n              <span style=\"display:flex;gap:14px;align-items:baseline;font-size:14.5px;color:#F4EFE6\"><span style=\"width:6px;height:6px;background:#E0B45A;transform:rotate(45deg);flex:none\"><\u002Fspan>Customs clearance at JNCH, Hazira &amp; ICD Surat<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"background:#FBF8F2;border:1px solid rgba(184,137,43,.45);border-radius:6px;padding:clamp(30px,3.6vw,52px);display:flex;flex-direction:column;gap:22px\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px\">\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">India → World<\u002Fspan>\n              <span style=\"font-weight:500;font-size:19px;color:#8F96AC\">Outbound<\u002Fspan>\n            <\u002Fdiv>\n            <h3 style=\"font-weight:500;font-size:clamp(34px,4vw,56px);line-height:1.04;letter-spacing:-.035em;color:#0F1730;margin:0\">Export<\u002Fh3>\n            <p style=\"font-size:16px;line-height:1.72;color:#2B3450;margin:0;text-wrap:pretty\">From product sourcing and quality checks to export documentation, packing and freight, we manage your outbound shipments from start to finish: making exporting from India simple, compliant and cost-effective.<\u002Fp>\n            <div style=\"display:grid;gap:12px;border-top:1px solid rgba(15,23,48,.12);padding-top:22px;margin-top:auto\">\n              <span style=\"display:flex;gap:14px;align-items:baseline;font-size:14.5px;color:#0F1730\"><span style=\"width:6px;height:6px;background:#B8892B;transform:rotate(45deg);flex:none\"><\u002Fspan>Product sourcing &amp; pre-shipment quality checks<\u002Fspan>\n              <span style=\"display:flex;gap:14px;align-items:baseline;font-size:14.5px;color:#0F1730\"><span style=\"width:6px;height:6px;background:#B8892B;transform:rotate(45deg);flex:none\"><\u002Fspan>Export documentation &amp; packing<\u002Fspan>\n              <span style=\"display:flex;gap:14px;align-items:baseline;font-size:14.5px;color:#0F1730\"><span style=\"width:6px;height:6px;background:#B8892B;transform:rotate(45deg);flex:none\"><\u002Fspan>Freight: LCL &amp; FCL, to buyers worldwide<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <p style=\"font-weight:500;font-size:clamp(20px,2vw,28px);line-height:1.4;color:#5A6178;margin:clamp(30px,3.5vw,48px) 0 0;text-align:center;text-wrap:balance\">Whichever direction your cargo moves, we manage it end-to-end.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section ref=\"{{ statsRef }}\" style=\"background:#0A1530;border-top:1px solid rgba(244,239,230,.1)\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:clamp(28px,3vw,40px)\">\n        <sc-for list=\"{{ stats }}\" as=\"s\" hint-placeholder-count=\"4\">\n          <div>\n            <div style=\"font-weight:400;font-size:clamp(44px,5vw,72px);line-height:1;letter-spacing:-.03em;color:#F4EFE6;font-variant-numeric:tabular-nums\">{{ s.num }}<span style=\"color:#E0B45A\">{{ s.suffix }}<\u002Fspan><\u002Fdiv>\n            <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin:22px 0 10px\">{{ s.title }}<\u002Fdiv>\n            <div style=\"font-size:14px;line-height:1.65;color:rgba(244,239,230,.62);max-width:26ch\">{{ s.sub }}<\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)\">\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(380px,100%),1fr));gap:clamp(28px,4vw,72px);align-items:end;margin-bottom:clamp(40px,5vw,72px)\">\n          <div>\n            <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n              <span style=\"font-weight:500;font-size:19px;color:#8F6A1C\">03<\u002Fspan>\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">What we do<\u002Fspan>\n            <\u002Fdiv>\n            <h2 style=\"font-weight:500;font-size:clamp(28px,3.4vw,46px);line-height:1.1;letter-spacing:-.03em;color:#0F1730;margin:0;text-wrap:balance\">Every step of your trade, <em style=\"font-style:normal;color:#B8892B\">handled.<\u002Fem><\u002Fh2>\n          <\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.75;color:#5A6178;margin:0;text-wrap:pretty\">Everbees Worldwide handles both sides of international trade. On the import side, we source and bring in quality products from global manufacturers. On the export side, we help take Indian products to buyers worldwide, with complete documentation, packing and shipping support.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"border-top:1px solid rgba(15,23,48,.14)\">\n          <sc-for list=\"{{ services }}\" as=\"sv\" hint-placeholder-count=\"6\">\n            <a href=\"#services\" sc-camel-on-click=\"{{ goServices }}\" style=\"display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 28px;padding:clamp(24px,2.6vw,34px) 0;border-bottom:1px solid rgba(15,23,48,.14);color:#0F1730;transition:padding-left .25s\" style-hover=\"padding-left:14px;color:#0F1730\">\n              <span style=\"font-weight:500;font-size:18px;color:#8F6A1C;width:44px;flex:none\">{{ sv.n }}<\u002Fspan>\n              <span style=\"font-weight:500;font-size:clamp(22px,2.2vw,30px);line-height:1.15;letter-spacing:-.01em;flex:1 1 240px;min-width:0\">{{ sv.title }}<\u002Fspan>\n              <span style=\"font-size:15px;line-height:1.65;color:#5A6178;flex:2 1 320px;min-width:0;text-wrap:pretty\">{{ sv.short }}<\u002Fspan>\n              <span style=\"font-weight:500;font-size:26px;line-height:1;color:#B8892B;flex:none\">→<\u002Fspan>\n            <\u002Fa>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#0A1530;position:relative;overflow:hidden\">\n      <div style=\"position:absolute;inset:0;background:radial-gradient(1000px 500px at 90% 0%,rgba(184,137,43,.2),rgba(10,21,48,0) 70%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)\">\n        <div style=\"display:flex;align-items:flex-end;justify-content:space-between;gap:28px;flex-wrap:wrap;margin-bottom:clamp(40px,5vw,64px)\">\n          <div>\n            <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n              <span style=\"font-weight:500;font-size:19px;color:#E0B45A\">04<\u002Fspan>\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62)\">Product range &amp; global sourcing<\u002Fspan>\n            <\u002Fdiv>\n            <h2 style=\"font-weight:500;font-size:clamp(28px,3.4vw,46px);line-height:1.1;letter-spacing:-.03em;color:#F4EFE6;margin:0 0 18px;max-width:20ch;text-wrap:balance\">An extensive range, <em style=\"font-style:normal;color:#E0B45A\">sourced direct.<\u002Fem><\u002Fh2>\n            <p style=\"font-size:16px;line-height:1.72;color:rgba(244,239,230,.7);margin:0;max-width:58ch;text-wrap:pretty\">Quality products sourced directly from a trusted network of verified manufacturers in India and overseas: a single category or a mixed container, in LCL and FCL quantities.<\u002Fp>\n          <\u002Fdiv>\n          <a href=\"#range\" sc-camel-on-click=\"{{ goRange }}\" style=\"display:inline-flex;align-items:center;gap:12px;font-weight:600;font-size:14px;letter-spacing:0;color:#F4EFE6;white-space:nowrap\" style-hover=\"color:#E0B45A\">Explore the full range <span style=\"font-weight:500;font-size:20px;line-height:1\">→<\u002Fspan><\u002Fa>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:clamp(14px,1.6vw,22px)\">\n          <sc-for list=\"{{ categories }}\" as=\"c\" hint-placeholder-count=\"6\">\n            <div style=\"border-radius:6px;padding:clamp(26px,2.6vw,36px);display:flex;flex-direction:column;gap:16px;min-height:280px;transition:transform .25s,border-color .25s;background:{{ c.bg }};border:1px solid {{ c.border }}\" style-hover=\"transform:translateY(-5px);border-color:#E0B45A\">\n              <span style=\"font-weight:500;font-size:34px;line-height:1;color:#E0B45A\">{{ c.n }}<\u002Fspan>\n              <h3 style=\"font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-.01em;color:#F4EFE6;margin:8px 0 0;text-wrap:balance\">{{ c.title }}<\u002Fh3>\n              <p style=\"font-size:14.5px;line-height:1.65;color:rgba(244,239,230,.68);margin:0;flex:1;text-wrap:pretty\">{{ c.line }}<\u002Fp>\n              <div style=\"display:flex;gap:22px;flex-wrap:wrap;border-top:1px solid rgba(244,239,230,.14);padding-top:18px\">\n                <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"font-weight:700;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:#F4EFE6\" style-hover=\"color:#E0B45A\">Enquire<\u002Fa>\n                <a href=\"{{ c.wa }}\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:#3DA935\" style-hover=\"color:#5CC754\"><span style=\"width:6px;height:6px;border-radius:50%;background:#3DA935\"><\u002Fspan>WhatsApp<\u002Fa>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));gap:clamp(40px,6vw,96px);align-items:center\">\n        <div style=\"position:relative;max-width:520px;width:100%;padding:18px 0 0 18px\">\n          <div style=\"position:absolute;top:0;right:18px;bottom:18px;left:0;border:1px solid rgba(184,137,43,.6);border-radius:4px;pointer-events:none\"><\u002Fdiv>\n          <div style=\"position:relative;aspect-ratio:3/4;border-radius:4px;overflow:hidden;box-shadow:0 30px 70px rgba(15,23,48,.22)\">\n            <img src=\"cc134087-03bb-43cf-accd-514b7a509566\" alt=\"Alish Hirpara at the Everbees Worldwide office in Surat\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n            <span style=\"font-weight:500;font-size:19px;color:#8F6A1C\">05<\u002Fspan>\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Leadership<\u002Fspan>\n          <\u002Fdiv>\n          <h2 style=\"font-weight:500;font-size:clamp(26px,3vw,40px);line-height:1.12;letter-spacing:-.03em;color:#0F1730;margin:0 0 26px;text-wrap:balance\">Built on a simple promise. <em style=\"font-style:normal;color:#B8892B\">the best quality at the best price.<\u002Fem><\u002Fh2>\n          <p style=\"font-size:16px;line-height:1.75;color:#2B3450;margin:0 0 18px;text-wrap:pretty\">Everbees Worldwide is led by Mr. Alish Hirpara, Authorised Director, whose expertise spans import and export, international trading and business management.<\u002Fp>\n          <p style=\"font-size:16px;line-height:1.75;color:#5A6178;margin:0 0 32px;text-wrap:pretty\">He specialises in China sourcing, sea freight and customs clearance at JNCH, Hazira and ICD Surat, with comprehensive handling of the banking, finance and compliance behind every shipment.<\u002Fp>\n          <div style=\"display:flex;align-items:center;gap:20px;flex-wrap:wrap;border-top:1px solid rgba(15,23,48,.14);padding-top:26px\">\n            <span style=\"display:flex;flex-direction:column;gap:5px\">\n              <span style=\"font-weight:500;font-size:26px;line-height:1;color:#0F1730\">Alish Hirpara<\u002Fspan>\n              <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Authorised Director, Everbees Worldwide Pvt. Ltd.<\u002Fspan>\n            <\u002Fspan>\n            <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"margin-left:auto;display:inline-flex;align-items:center;gap:10px;background:#0A1530;color:#F4EFE6;padding:15px 26px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#B8892B;color:#0A1530\">Talk to Alish<\u002Fa>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <sc-if value=\"{{ showTestimonials }}\" hint-placeholder-val=\"{{ true }}\">\n    <section style=\"background:#FBF8F2;border-top:1px solid rgba(15,23,48,.1)\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)\">\n        <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n          <span style=\"font-weight:500;font-size:19px;color:#8F6A1C\">06<\u002Fspan>\n          <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">What our clients say<\u002Fspan>\n        <\u002Fdiv>\n        <h2 style=\"font-weight:500;font-size:clamp(28px,3.4vw,46px);line-height:1.1;letter-spacing:-.03em;color:#0F1730;margin:0 0 clamp(36px,4vw,56px);max-width:20ch;text-wrap:balance\">Trusted by buyers <em style=\"font-style:normal;color:#B8892B\">across borders.<\u002Fem><\u002Fh2>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:clamp(16px,2vw,28px)\">\n          <sc-for list=\"{{ testimonials }}\" as=\"q\" hint-placeholder-count=\"3\">\n            <div style=\"background:#F4EFE6;border:1px solid rgba(15,23,48,.12);border-radius:6px;padding:clamp(28px,3vw,40px);display:flex;flex-direction:column;gap:20px\">\n              <span style=\"font-weight:500;font-size:72px;line-height:.6;color:#B8892B\">“<\u002Fspan>\n              <p style=\"font-weight:500;font-size:clamp(20px,1.7vw,24px);line-height:1.4;color:#2B3450;margin:0;flex:1;text-wrap:pretty\">{{ q.quote }}<\u002Fp>\n              <div style=\"border-top:1px solid rgba(15,23,48,.12);padding-top:18px;display:flex;flex-direction:column;gap:5px\">\n                <span style=\"font-weight:700;font-size:13px;letter-spacing:.06em;color:#0F1730\">{{ q.name }}<\u002Fspan>\n                <span style=\"font-size:12.5px;color:#5A6178\">{{ q.meta }}<\u002Fspan>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n    <\u002Fsc-if>\n\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isAbout }}\">\n  <main data-screen-label=\"About\" style=\"animation:ebFade .4s ease both\">\n    <section style=\"background:#0A1530;position:relative;overflow:hidden\">\n      <div style=\"position:absolute;inset:0;background:radial-gradient(900px 420px at 90% 0%,rgba(184,137,43,.24),rgba(10,21,48,0) 70%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(440px,100%),1fr));gap:clamp(36px,5vw,80px);align-items:center\">\n        <div>\n          <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:22px\">About us<\u002Fdiv>\n          <h1 style=\"font-weight:500;font-size:clamp(32px,4.2vw,60px);line-height:1.06;letter-spacing:-.03em;color:#F4EFE6;margin:0 0 26px;text-wrap:balance\">The right product, at the right price, <em style=\"font-style:normal;color:#E0B45A\">delivered to your door.<\u002Fem><\u002Fh1>\n          <p style=\"font-size:clamp(16px,1.2vw,18px);line-height:1.72;color:rgba(244,239,230,.74);margin:0;max-width:54ch;text-wrap:pretty\">A Surat-based, registered private limited company handling import, export, sourcing and logistics for buyers across India and overseas.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"position:relative;max-width:440px;width:100%;margin:0 auto;padding:0 18px 18px 0\">\n          <div style=\"position:absolute;top:18px;right:0;bottom:0;left:18px;border:1px solid rgba(224,180,90,.55);border-radius:4px;pointer-events:none\"><\u002Fdiv>\n          <div style=\"position:relative;aspect-ratio:2/3;border-radius:4px;overflow:hidden;box-shadow:0 40px 90px rgba(0,0,0,.45)\">\n            <img src=\"2099e830-c8ed-489c-88bb-60811c762147\" alt=\"Alish Hirpara, Authorised Director\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));gap:clamp(36px,5vw,80px);align-items:start\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Our story<\u002Fspan>\n          <\u002Fdiv>\n          <p style=\"font-weight:500;font-size:clamp(24px,2.3vw,32px);line-height:1.35;color:#0F1730;margin:0 0 24px;text-wrap:pretty\">Everbees Worldwide Private Limited is a Surat-based international trading company built on a simple promise: the best quality at the best price.<\u002Fp>\n          <p style=\"font-size:16px;line-height:1.78;color:#2B3450;margin:0 0 18px;text-wrap:pretty\">What began as a focused import operation has grown into a complete import-export and logistics service, backed by 80+ successful shipments and clients across the globe.<\u002Fp>\n          <p style=\"font-size:16px;line-height:1.78;color:#5A6178;margin:0;text-wrap:pretty\">Our strength lies in doing the hard work for our clients: sourcing dependable suppliers, negotiating the sharpest prices, and managing every logistics and customs detail so goods arrive smoothly. Whether it is a single LCL consignment or a full FCL container, we bring the same care, transparency and round-the-clock support to every order.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"display:grid;gap:18px\">\n          <div style=\"background:#0A1530;border-radius:6px;padding:clamp(28px,3vw,40px)\">\n            <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:14px\">Our vision<\u002Fdiv>\n            <p style=\"font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.3;color:#F4EFE6;margin:0;text-wrap:pretty\">To be a trusted name in global trade, connecting quality products with businesses worldwide.<\u002Fp>\n          <\u002Fdiv>\n          <div style=\"background:#FBF8F2;border:1px solid rgba(184,137,43,.45);border-radius:6px;padding:clamp(28px,3vw,40px)\">\n            <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A;margin-bottom:14px\">Our mission<\u002Fdiv>\n            <p style=\"font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.3;color:#0F1730;margin:0;text-wrap:pretty\">To deliver reliable, cost-effective import and export solutions with honesty, speed and excellent service.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6;border-top:1px solid rgba(15,23,48,.1)\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));gap:clamp(36px,5vw,80px);align-items:center\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Leadership<\u002Fspan>\n          <\u002Fdiv>\n          <h2 style=\"font-weight:500;font-size:clamp(26px,3vw,40px);line-height:1.12;letter-spacing:-.03em;color:#0F1730;margin:0 0 22px\">Alish Hirpara<\u002Fh2>\n          <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A;margin-bottom:24px\">Authorised Director<\u002Fdiv>\n          <p style=\"font-size:16px;line-height:1.78;color:#2B3450;margin:0 0 16px;text-wrap:pretty\">Expertise in import and export, international trading and business management.<\u002Fp>\n          <p style=\"font-size:16px;line-height:1.78;color:#5A6178;margin:0 0 30px;text-wrap:pretty\">Specialising in China sourcing, sea freight and customs clearance at JNCH, Hazira and ICD Surat, with comprehensive handling of banking, finance and compliance for every client.<\u002Fp>\n          <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;gap:10px;background:#0A1530;color:#F4EFE6;padding:15px 26px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#B8892B;color:#0A1530\">Talk to Alish<\u002Fa>\n        <\u002Fdiv>\n        <div style=\"display:grid;gap:18px\">\n          <div style=\"aspect-ratio:1;border-radius:4px;overflow:hidden;box-shadow:0 30px 70px rgba(15,23,48,.2)\">\n            <img src=\"7b50a5d9-45a7-400f-8cb7-6d9f8f5435c4\" alt=\"Alish Hirpara\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n          <\u002Fdiv>\n          <div style=\"background:#0A1530;border-radius:6px;padding:clamp(26px,2.6vw,34px)\">\n            <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:20px\">Company details<\u002Fdiv>\n            <div style=\"display:grid;gap:13px;font-size:14px;line-height:1.55\">\n              <div style=\"display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap\"><span style=\"color:rgba(244,239,230,.55)\">Registered name<\u002Fspan><span style=\"color:#F4EFE6;font-weight:600;text-align:right\">Everbees Worldwide Private Limited<\u002Fspan><\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap\"><span style=\"color:rgba(244,239,230,.55)\">Head office<\u002Fspan><span style=\"color:#F4EFE6;font-weight:600;text-align:right;max-width:30ch\">324, Prime Arcade, Nr. Raghuvir Shoppers, Mota Varachha, Surat 394101, Gujarat, India<\u002Fspan><\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap\"><span style=\"color:rgba(244,239,230,.55)\">Authorised director<\u002Fspan><span style=\"color:#F4EFE6;font-weight:600;text-align:right\">Mr. Alish Hirpara<\u002Fspan><\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap\"><span style=\"color:rgba(244,239,230,.55)\">CIN<\u002Fspan><span style=\"color:#F4EFE6;font-weight:600;text-align:right\">U13999GJ2024PTC152828<\u002Fspan><\u002Fdiv>\n              <div style=\"display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap\"><span style=\"color:rgba(244,239,230,.55)\">GSTIN<\u002Fspan><span style=\"color:#F4EFE6;font-weight:600;text-align:right\">24AAICE2625C1Z5<\u002Fspan><\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isServices }}\">\n  <main data-screen-label=\"Services\" style=\"animation:ebFade .4s ease both\">\n    <section style=\"background:#0A1530;position:relative;overflow:hidden\">\n      <div style=\"position:absolute;inset:0;background:radial-gradient(900px 420px at 90% 0%,rgba(184,137,43,.24),rgba(10,21,48,0) 70%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px)\">\n        <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:22px\">Services<\u002Fdiv>\n        <h1 style=\"font-weight:500;font-size:clamp(32px,4.2vw,60px);line-height:1.06;letter-spacing:-.03em;color:#F4EFE6;margin:0 0 26px;max-width:16ch;text-wrap:balance\">End-to-end international <em style=\"font-style:normal;color:#E0B45A\">trade solutions.<\u002Fem><\u002Fh1>\n        <p style=\"font-size:clamp(16px,1.2vw,18px);line-height:1.72;color:rgba(244,239,230,.74);margin:0;max-width:66ch;text-wrap:pretty\">Everbees Worldwide handles both sides of international trade. On the import side, we source and bring in quality products from global manufacturers. On the export side, we help take Indian products to buyers worldwide, with complete documentation, packing and shipping support. Whichever direction your cargo moves, we manage it end-to-end.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(360px,100%),1fr));gap:clamp(16px,2vw,28px)\">\n        <sc-for list=\"{{ services }}\" as=\"sv\" hint-placeholder-count=\"6\">\n          <div style=\"background:#FBF8F2;border:1px solid rgba(15,23,48,.12);border-radius:6px;padding:clamp(28px,3vw,40px);display:flex;flex-direction:column;gap:16px;transition:transform .25s,border-color .25s\" style-hover=\"transform:translateY(-5px);border-color:#B8892B\">\n            <span style=\"font-weight:500;font-size:30px;line-height:1;color:#B8892B\">{{ sv.n }}<\u002Fspan>\n            <h3 style=\"font-weight:500;font-size:clamp(22px,2.1vw,29px);line-height:1.2;letter-spacing:-.01em;color:#0F1730;margin:6px 0 0;text-wrap:balance\">{{ sv.title }}<\u002Fh3>\n            <p style=\"font-size:15.5px;line-height:1.7;color:#5A6178;margin:0;text-wrap:pretty\">{{ sv.body }}<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6;border-top:1px solid rgba(15,23,48,.1)\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)\">\n        <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n          <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">How an order moves<\u002Fspan>\n        <\u002Fdiv>\n        <h2 style=\"font-weight:500;font-size:clamp(28px,3.4vw,46px);line-height:1.1;letter-spacing:-.03em;color:#0F1730;margin:0 0 clamp(36px,4vw,56px);max-width:18ch;text-wrap:balance\">From enquiry to <em style=\"font-style:normal;color:#B8892B\">your door.<\u002Fem><\u002Fh2>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(220px,100%),1fr));gap:clamp(20px,2.4vw,32px)\">\n          <sc-for list=\"{{ process }}\" as=\"p\" hint-placeholder-count=\"5\">\n            <div>\n              <span style=\"font-weight:500;font-size:22px;color:#8F6A1C\">{{ p.n }}<\u002Fspan>\n              <h3 style=\"font-weight:500;font-size:24px;line-height:1.15;color:#0F1730;margin:14px 0 12px\">{{ p.title }}<\u002Fh3>\n              <p style=\"font-size:14.5px;line-height:1.68;color:#5A6178;margin:0;text-wrap:pretty\">{{ p.body }}<\u002Fp>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6;padding:0 clamp(20px,5vw,72px) clamp(72px,9vw,140px)\">\n      <div style=\"max-width:1320px;margin:0 auto;position:relative;border-radius:6px;overflow:hidden;box-shadow:0 30px 70px rgba(15,23,48,.22)\">\n        <img src=\"5fb9cd4f-b2ad-4b9e-bdbb-8fcbbb14a560\" alt=\"Sealed container on trailer, ready for despatch\" loading=\"lazy\" style=\"width:100%;aspect-ratio:16/7;object-fit:cover;display:block;min-height:320px\">\n        <div style=\"position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,21,48,.92) 0%,rgba(10,21,48,.6) 50%,rgba(10,21,48,.1) 100%);display:flex;align-items:center\">\n          <div style=\"padding:clamp(26px,4vw,64px);max-width:min(620px,80%)\">\n            <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:16px\">Sealed and on the way<\u002Fdiv>\n            <p style=\"font-weight:500;font-size:clamp(22px,2.6vw,36px);line-height:1.2;color:#F4EFE6;margin:0 0 26px;text-wrap:balance\">Booked, stuffed, sealed and cleared. We stay on your cargo until it reaches your door.<\u002Fp>\n            <div style=\"display:flex;gap:12px;flex-wrap:wrap\">\n              <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"display:inline-flex;align-items:center;background:#E0B45A;color:#0A1530;padding:15px 26px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#F4EFE6;color:#0A1530\">Get a Quote<\u002Fa>\n              <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;background:#1B7F35;color:#F4EFE6;padding:15px 26px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#156A2B;color:#F4EFE6\">WhatsApp Us<\u002Fa>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isRange }}\">\n  <main data-screen-label=\"Product Range\" style=\"animation:ebFade .4s ease both\">\n    <section style=\"background:#0A1530;position:relative;overflow:hidden\">\n      <div style=\"position:absolute;inset:0;background:radial-gradient(900px 420px at 90% 0%,rgba(184,137,43,.24),rgba(10,21,48,0) 70%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px)\">\n        <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:22px\">Product range &amp; global sourcing<\u002Fdiv>\n        <h1 style=\"font-weight:500;font-size:clamp(32px,4.2vw,60px);line-height:1.06;letter-spacing:-.03em;color:#F4EFE6;margin:0 0 26px;max-width:16ch;text-wrap:balance\">Product Range &amp; <em style=\"font-style:normal;color:#E0B45A\">Global Sourcing<\u002Fem><\u002Fh1>\n        <p style=\"font-size:clamp(16px,1.2vw,18px);line-height:1.72;color:rgba(244,239,230,.74);margin:0;max-width:66ch;text-wrap:pretty\">Everbees Worldwide supplies an extensive and ever-growing range of quality products, sourced directly from a trusted network of verified manufacturers in India and overseas. Whether you need a single category or a mixed container, we deliver the right product at the right price, available in both LCL and FCL quantities.<\u002Fp>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#0A1530;border-top:1px solid rgba(244,239,230,.1)\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:clamp(14px,1.6vw,22px)\">\n        <sc-for list=\"{{ categories }}\" as=\"c\" hint-placeholder-count=\"6\">\n          <div style=\"border-radius:6px;padding:clamp(26px,2.6vw,36px);display:flex;flex-direction:column;gap:16px;min-height:300px;transition:transform .25s,border-color .25s;background:{{ c.bg }};border:1px solid {{ c.border }}\" style-hover=\"transform:translateY(-5px);border-color:#E0B45A\">\n            <span style=\"font-weight:500;font-size:34px;line-height:1;color:#E0B45A\">{{ c.n }}<\u002Fspan>\n            <h3 style=\"font-weight:500;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-.01em;color:#F4EFE6;margin:8px 0 0;text-wrap:balance\">{{ c.title }}<\u002Fh3>\n            <p style=\"font-size:14.5px;line-height:1.65;color:rgba(244,239,230,.68);margin:0;flex:1;text-wrap:pretty\">{{ c.line }}<\u002Fp>\n            <div style=\"display:flex;gap:12px;flex-wrap:wrap;border-top:1px solid rgba(244,239,230,.14);padding-top:20px\">\n              <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"flex:1;min-width:120px;text-align:center;background:#F4EFE6;color:#0A1530;padding:13px 16px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"background:#E0B45A;color:#0A1530\">Enquire<\u002Fa>\n              <a href=\"{{ c.wa }}\" target=\"_blank\" rel=\"noopener\" style=\"flex:1;min-width:120px;text-align:center;border:1px solid rgba(61,169,53,.6);color:#5CC754;padding:13px 16px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"background:#1B7F35;color:#F4EFE6;border-color:#1B7F35\">WhatsApp<\u002Fa>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(36px,5vw,80px);align-items:start\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#6F768A\">Trusted supplier network<\u002Fspan>\n          <\u002Fdiv>\n          <h2 style=\"font-weight:500;font-size:clamp(28px,3.3vw,44px);line-height:1.1;letter-spacing:-.03em;color:#0F1730;margin:0 0 26px;text-wrap:balance\">A genuine company, backed by a <em style=\"font-style:normal;color:#B8892B\">verified supplier network.<\u002Fem><\u002Fh2>\n          <p style=\"font-size:16px;line-height:1.78;color:#2B3450;margin:0;text-wrap:pretty\">As a registered private limited company, we work only with genuine, factory-direct suppliers. Every product is quality-checked before dispatch, and every order is handled with full documentation and complete transparency. If you need a product that isn't listed, just tell us and our sourcing team will find it and quote you the best landed price.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:0;border-top:1px solid rgba(15,23,48,.14)\">\n          <sc-for list=\"{{ network }}\" as=\"k\" hint-placeholder-count=\"6\">\n            <div style=\"display:flex;gap:16px;align-items:flex-start;padding:22px 0;border-bottom:1px solid rgba(15,23,48,.14)\">\n              <span style=\"width:26px;height:26px;border-radius:50%;border:1px solid #B8892B;color:#8F6A1C;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;flex:none\">✓<\u002Fspan>\n              <span style=\"font-weight:500;font-size:21px;line-height:1.3;color:#0F1730\">{{ k.label }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6;padding:0 clamp(20px,5vw,72px) clamp(72px,9vw,140px)\">\n      <div style=\"max-width:1320px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:clamp(14px,1.6vw,22px)\">\n        <div style=\"position:relative;aspect-ratio:4/3;border-radius:6px;overflow:hidden\">\n          <img src=\"fe7d7812-9895-4ff0-ba6a-ac8c2c664589\" alt=\"Crated glass consignment inside a container\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n        <\u002Fdiv>\n        <div style=\"position:relative;aspect-ratio:4/3;border-radius:6px;overflow:hidden\">\n          <img src=\"477595d8-686e-45b8-aaed-d402d89593c5\" alt=\"Palletised cartons loaded in a 40ft container\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover;display:block\">\n        <\u002Fdiv>\n        <div style=\"background:#0A1530;border-radius:6px;padding:clamp(28px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between;gap:24px;min-height:100%\">\n          <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62)\">From our recent shipments<\u002Fdiv>\n          <p style=\"font-weight:500;font-size:clamp(24px,2.2vw,32px);line-height:1.2;color:#F4EFE6;margin:0;text-wrap:balance\">Quality checked, packed and documented before every container is sealed.<\u002Fp>\n          <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"display:inline-flex;align-items:center;gap:12px;font-weight:600;font-size:14px;letter-spacing:0;color:#F4EFE6;align-self:flex-start\" style-hover=\"color:#E0B45A\">Request a quote <span style=\"font-weight:500;font-size:20px;line-height:1\">→<\u002Fspan><\u002Fa>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isWhy }}\">\n  <main data-screen-label=\"Why Us\" style=\"animation:ebFade .4s ease both\">\n    <section style=\"background:#0A1530;position:relative;overflow:hidden\">\n      <div style=\"position:absolute;inset:0;background:radial-gradient(900px 420px at 90% 0%,rgba(184,137,43,.24),rgba(10,21,48,0) 70%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px)\">\n        <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:22px\">Why choose us<\u002Fdiv>\n        <h1 style=\"font-weight:500;font-size:clamp(32px,4.2vw,60px);line-height:1.06;letter-spacing:-.03em;color:#F4EFE6;margin:0;max-width:16ch;text-wrap:balance\">Six reasons buyers <em style=\"font-style:normal;color:#E0B45A\">stay with us.<\u002Fem><\u002Fh1>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px)\">\n        <div style=\"border-top:1px solid rgba(15,23,48,.14)\">\n          <sc-for list=\"{{ why }}\" as=\"w\" hint-placeholder-count=\"6\">\n            <div style=\"display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 28px;padding:clamp(26px,2.8vw,38px) 0;border-bottom:1px solid rgba(15,23,48,.14)\">\n              <span style=\"font-weight:500;font-size:18px;color:#8F6A1C;width:44px;flex:none\">{{ w.n }}<\u002Fspan>\n              <span style=\"font-weight:500;font-size:clamp(24px,2.6vw,34px);line-height:1.15;letter-spacing:-.01em;color:#0F1730;flex:1 1 240px;min-width:0\">{{ w.title }}<\u002Fspan>\n              <span style=\"font-size:16px;line-height:1.7;color:#5A6178;flex:2 1 320px;min-width:0;text-wrap:pretty\">{{ w.body }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#0A1530\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(72px,9vw,140px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));gap:clamp(36px,5vw,80px);align-items:center\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:14px;margin-bottom:26px\">\n            <span style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62)\">Genuine &amp; registered<\u002Fspan>\n          <\u002Fdiv>\n          <h2 style=\"font-weight:500;font-size:clamp(26px,3.1vw,42px);line-height:1.12;letter-spacing:-.03em;color:#F4EFE6;margin:0 0 22px;text-wrap:balance\">A registered company you can <em style=\"font-style:normal;color:#E0B45A\">verify.<\u002Fem><\u002Fh2>\n          <p style=\"font-size:16px;line-height:1.75;color:rgba(244,239,230,.72);margin:0 0 30px;text-wrap:pretty\">Trade references and supplier details available to serious buyers on request.<\u002Fp>\n          <a href=\"#contact\" sc-camel-on-click=\"{{ goContact }}\" style=\"display:inline-flex;align-items:center;background:#E0B45A;color:#0A1530;padding:17px 30px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#F4EFE6;color:#0A1530\">Get a Quote<\u002Fa>\n        <\u002Fdiv>\n        <div style=\"display:grid;border-top:1px solid rgba(244,239,230,.14)\">\n          <sc-for list=\"{{ trust }}\" as=\"t\" hint-placeholder-count=\"6\">\n            <div style=\"display:flex;gap:18px;align-items:center;padding:20px 0;border-bottom:1px solid rgba(244,239,230,.14)\">\n              <span style=\"width:7px;height:7px;background:#E0B45A;transform:rotate(45deg);flex:none\"><\u002Fspan>\n              <span style=\"font-weight:500;font-size:clamp(20px,1.8vw,24px);line-height:1.3;color:#F4EFE6\">{{ t.label }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <sc-if value=\"{{ isContact }}\">\n  <main data-screen-label=\"Contact\" style=\"animation:ebFade .4s ease both\">\n    <section style=\"background:#0A1530;position:relative;overflow:hidden\">\n      <div style=\"position:absolute;inset:0;background:radial-gradient(900px 420px at 90% 0%,rgba(184,137,43,.24),rgba(10,21,48,0) 70%);pointer-events:none\"><\u002Fdiv>\n      <div style=\"position:relative;max-width:1320px;margin:0 auto;padding:clamp(56px,7vw,104px) clamp(20px,5vw,72px)\">\n        <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:22px\">Contact<\u002Fdiv>\n        <h1 style=\"font-weight:500;font-size:clamp(32px,4.2vw,60px);line-height:1.06;letter-spacing:-.03em;color:#F4EFE6;margin:0;max-width:16ch;text-wrap:balance\">Let's work <em style=\"font-style:normal;color:#E0B45A\">together.<\u002Fem><\u002Fh1>\n      <\u002Fdiv>\n    <\u002Fsection>\n\n    <section style=\"background:#F4EFE6\">\n      <div style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,5vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr));gap:clamp(36px,5vw,72px);align-items:start\">\n        <div>\n          <h2 style=\"font-weight:500;font-size:clamp(28px,2.8vw,38px);line-height:1.1;color:#0F1730;margin:0 0 12px\">Send an enquiry<\u002Fh2>\n          <p style=\"font-size:15px;line-height:1.7;color:#5A6178;margin:0 0 30px;text-wrap:pretty\">Tell us the product, quantity and destination. We reply with landed pricing and a shipping plan, usually within one working day.<\u002Fp>\n\n          <sc-if value=\"{{ formSent }}\">\n            <div style=\"background:#0A1530;border-radius:6px;padding:clamp(28px,3vw,40px);animation:ebRise .5s ease both\">\n              <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:14px\">Enquiry received<\u002Fdiv>\n              <p style=\"font-weight:500;font-size:clamp(24px,2.2vw,32px);line-height:1.2;color:#F4EFE6;margin:0 0 18px\">Thank you. Our team will reply shortly.<\u002Fp>\n              <p style=\"font-size:14.5px;line-height:1.7;color:rgba(244,239,230,.7);margin:0\">Need a faster answer? <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"color:#5CC754;font-weight:700\" style-hover=\"color:#F4EFE6\">Message us on WhatsApp<\u002Fa>.<\u002Fp>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ formOpen }}\" hint-placeholder-val=\"{{ true }}\">\n            <form name=\"enquiry\" method=\"POST\" action=\"/\" data-netlify=\"true\" netlify-honeypot=\"bot-field\" sc-camel-on-submit=\"{{ submitEnquiry }}\" style=\"display:grid;gap:18px\">\n              <input type=\"hidden\" name=\"form-name\" value=\"enquiry\">\n              <div style=\"display:none\"><label>Leave this empty <input name=\"bot-field\" sc-camel-on-change=\"{{ onBot }}\"><\u002Flabel><\u002Fdiv>\n              <label style=\"display:grid;gap:9px\">\n                <span style=\"font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#0F1730\">Your name<\u002Fspan>\n                <input type=\"text\" name=\"name\" required=\"{{ true }}\" value=\"{{ form.name }}\" sc-camel-on-change=\"{{ onName }}\" placeholder=\"Full name\" style=\"border:1px solid rgba(15,23,48,.2);border-radius:4px;padding:16px 18px;font-size:15px;color:#0F1730;background:#FBF8F2;outline:none;width:100%\" style-focus=\"border-color:#B8892B;box-shadow:0 0 0 3px rgba(184,137,43,.16)\">\n              <\u002Flabel>\n              <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:18px\">\n                <label style=\"display:grid;gap:9px\">\n                  <span style=\"font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#0F1730\">Phone / WhatsApp<\u002Fspan>\n                  <input type=\"tel\" name=\"phone\" required=\"{{ true }}\" value=\"{{ form.phone }}\" sc-camel-on-change=\"{{ onPhone }}\" placeholder=\"+91 00000 00000\" style=\"border:1px solid rgba(15,23,48,.2);border-radius:4px;padding:16px 18px;font-size:15px;color:#0F1730;background:#FBF8F2;outline:none;width:100%\" style-focus=\"border-color:#B8892B;box-shadow:0 0 0 3px rgba(184,137,43,.16)\">\n                <\u002Flabel>\n                <label style=\"display:grid;gap:9px\">\n                  <span style=\"font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#0F1730\">E-mail<\u002Fspan>\n                  <input type=\"email\" name=\"email\" value=\"{{ form.email }}\" sc-camel-on-change=\"{{ onEmail }}\" placeholder=\"you@company.com\" style=\"border:1px solid rgba(15,23,48,.2);border-radius:4px;padding:16px 18px;font-size:15px;color:#0F1730;background:#FBF8F2;outline:none;width:100%\" style-focus=\"border-color:#B8892B;box-shadow:0 0 0 3px rgba(184,137,43,.16)\">\n                <\u002Flabel>\n              <\u002Fdiv>\n              <label style=\"display:grid;gap:9px\">\n                <span style=\"font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#0F1730\">What do you need?<\u002Fspan>\n                <textarea name=\"message\" rows=\"5\" value=\"{{ form.message }}\" sc-camel-on-change=\"{{ onMessage }}\" placeholder=\"Product or category, quantity, destination port, import or export, LCL or FCL…\" style=\"border:1px solid rgba(15,23,48,.2);border-radius:4px;padding:16px 18px;font-size:15px;line-height:1.6;color:#0F1730;background:#FBF8F2;outline:none;width:100%;resize:vertical;font-family:'Plus Jakarta Sans',sans-serif\" style-focus=\"border-color:#B8892B;box-shadow:0 0 0 3px rgba(184,137,43,.16)\"><\u002Ftextarea>\n              <\u002Flabel>\n              <div style=\"display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:6px\">\n                <button type=\"submit\" disabled=\"{{ formSending }}\" style=\"background:#0A1530;color:#F4EFE6;border:none;padding:17px 30px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap;cursor:pointer\" style-hover=\"background:#B8892B;color:#0A1530\">{{ submitLabel }}<\u002Fbutton>\n                <button type=\"button\" sc-camel-on-click=\"{{ sendWhatsapp }}\" style=\"background:transparent;color:#1B7F35;border:1px solid rgba(27,127,53,.5);padding:17px 28px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap;cursor:pointer\" style-hover=\"background:#1B7F35;color:#F4EFE6\">Send on WhatsApp<\u002Fbutton>\n              <\u002Fdiv>\n              <sc-if value=\"{{ formFailed }}\">\n                <p style=\"font-size:13.5px;line-height:1.6;color:#8F6A1C;margin:0\">We could not reach the server, so your mail app has been opened with the enquiry ready to send. You can also WhatsApp us directly.<\u002Fp>\n              <\u002Fsc-if>\n              <p style=\"font-size:13px;line-height:1.6;color:#5A6178;margin:4px 0 0;letter-spacing:.02em\">Trade references and supplier details available to serious buyers on request.<\u002Fp>\n            <\u002Fform>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n\n        <div style=\"display:grid;gap:18px\">\n          <div style=\"background:#0A1530;border-radius:6px;padding:clamp(28px,3vw,40px);display:grid;gap:26px\">\n            <div>\n              <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:12px\">Head office<\u002Fdiv>\n              <p style=\"font-weight:500;font-size:clamp(20px,1.8vw,24px);line-height:1.35;color:#F4EFE6;margin:0\">324, Prime Arcade, Nr. Raghuvir Shoppers,<br>Mota Varachha, Surat 394101,<br>Gujarat, India<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:22px\">\n              <div>\n                <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:10px\">Phone / WhatsApp<\u002Fdiv>\n                <a href=\"tel:+919099031705\" style=\"font-weight:500;font-size:15px;color:#F4EFE6\" style-hover=\"color:#E0B45A\">+91 90990 31705<\u002Fa>\n              <\u002Fdiv>\n              <div>\n                <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:10px\">E-mail<\u002Fdiv>\n                <a href=\"mailto:everbeesworldwide2406@gmail.com\" style=\"font-size:15px;color:#F4EFE6;overflow-wrap:anywhere\" style-hover=\"color:#E0B45A\">everbeesworldwide2406<wbr>@gmail.com<\u002Fa>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div>\n              <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:rgba(244,239,230,.62);margin-bottom:10px\">Hours<\u002Fdiv>\n              <p style=\"font-size:15px;line-height:1.7;color:rgba(244,239,230,.8);margin:0\">Office visits: Monday to Friday, by appointment.<br>Client support: 24/7 on phone and WhatsApp.<\u002Fp>\n            <\u002Fdiv>\n            <div style=\"display:flex;gap:12px;flex-wrap:wrap\">\n              <a href=\"tel:+919099031705\" style=\"flex:1;min-width:140px;text-align:center;background:#E0B45A;color:#0A1530;padding:15px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"background:#F4EFE6;color:#0A1530\">Call Now<\u002Fa>\n              <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"flex:1;min-width:140px;text-align:center;background:#1B7F35;color:#F4EFE6;padding:15px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"background:#156A2B;color:#F4EFE6\">WhatsApp<\u002Fa>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"border-radius:6px;overflow:hidden;border:1px solid rgba(15,23,48,.12);background:#FBF8F2;height:clamp(260px,30vw,360px)\">\n            <iframe title=\"Everbees Worldwide office location\" src=\"https://www.google.com/maps?q=Prime+Arcade+Mota+Varachha+Surat+394101&amp;output=embed\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" style=\"width:100%;height:100%;border:0;display:block;filter:grayscale(.2)\"><\u002Fiframe>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsection>\n  <\u002Fmain>\n  <\u002Fsc-if>\n\n  <footer style=\"background:#070F24;color:rgba(244,239,230,.62);position:relative;overflow:hidden\">\n    <div style=\"max-width:1320px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,5vw,72px) 0\">\n      <div style=\"display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;border-bottom:1px solid rgba(244,239,230,.12);padding-bottom:clamp(28px,3vw,44px)\">\n        <div style=\"font-weight:500;font-size:clamp(30px,5vw,72px);line-height:1;letter-spacing:-.035em;color:#F4EFE6\">Everbees <em style=\"font-style:normal;color:#E0B45A\">Worldwide<\u002Fem><\u002Fdiv>\n        <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;gap:10px;background:#1B7F35;color:#F4EFE6;padding:16px 26px;border-radius:999px;font-weight:600;font-size:14px;letter-spacing:0;white-space:nowrap\" style-hover=\"background:#156A2B;color:#F4EFE6\">Chat on WhatsApp<\u002Fa>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr));gap:clamp(32px,4vw,56px);padding:clamp(40px,5vw,64px) 0\">\n        <div>\n          <div style=\"display:flex;align-items:center;gap:13px;margin-bottom:22px\">\n            <img src=\"864cc7e7-fb3a-4007-98f7-dec288b277b4\" alt=\"\" style=\"height:42px;width:auto;display:block\">\n            <span style=\"display:flex;flex-direction:column;gap:4px\">\n              <span style=\"font-weight:800;font-size:14px;letter-spacing:.24em;color:#F4EFE6;line-height:1\">EVERBEES<\u002Fspan>\n              <span style=\"font-weight:600;font-size:9px;letter-spacing:.36em;color:#E0B45A;line-height:1\">WORLDWIDE<\u002Fspan>\n            <\u002Fspan>\n          <\u002Fdiv>\n          <p style=\"font-size:14px;line-height:1.75;margin:0 0 18px;max-width:36ch;text-wrap:pretty\">Surat-based import &amp; export company delivering complete international trade solutions: global sourcing, LCL &amp; FCL shipments, freight, logistics and customs clearance.<\u002Fp>\n          <p style=\"font-weight:500;font-size:18px;line-height:1.4;color:#E0B45A;margin:0\">Sourced with care. Shipped with certainty.<\u002Fp>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#F4EFE6;margin-bottom:22px\">Explore<\u002Fdiv>\n          <div style=\"display:grid;gap:12px\">\n            <sc-for list=\"{{ nav }}\" as=\"item\" hint-placeholder-count=\"6\">\n              <a href=\"{{ item.href }}\" sc-camel-on-click=\"{{ item.go }}\" style=\"font-size:14.5px;color:rgba(244,239,230,.62)\" style-hover=\"color:#E0B45A\">{{ item.label }}<\u002Fa>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#F4EFE6;margin-bottom:22px\">Services<\u002Fdiv>\n          <div style=\"display:grid;gap:12px\">\n            <sc-for list=\"{{ services }}\" as=\"sv\" hint-placeholder-count=\"6\">\n              <a href=\"#services\" sc-camel-on-click=\"{{ goServices }}\" style=\"font-size:14.5px;color:rgba(244,239,230,.62)\" style-hover=\"color:#E0B45A\">{{ sv.title }}<\u002Fa>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div>\n          <div style=\"font-size:13.5px;font-weight:500;letter-spacing:0;color:#F4EFE6;margin-bottom:22px\">Get in touch<\u002Fdiv>\n          <div style=\"display:grid;gap:14px;font-size:14.5px;line-height:1.7\">\n            <span>324, Prime Arcade, Nr. Raghuvir Shoppers, Mota Varachha, Surat 394101, Gujarat, India<\u002Fspan>\n            <a href=\"tel:+919099031705\" style=\"color:#F4EFE6;font-weight:500;font-size:14.5px\" style-hover=\"color:#E0B45A\">+91 90990 31705<\u002Fa>\n            <a href=\"mailto:everbeesworldwide2406@gmail.com\" style=\"color:rgba(244,239,230,.62);overflow-wrap:anywhere\" style-hover=\"color:#E0B45A\">everbeesworldwide2406<wbr>@gmail.com<\u002Fa>\n            <span style=\"color:rgba(244,239,230,.5);font-size:13px\">Office Mon to Fri by appointment | Support 24/7<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"border-top:1px solid rgba(244,239,230,.12);padding:22px 0;display:flex;gap:10px 32px;flex-wrap:wrap;font-size:12.5px;letter-spacing:.04em\">\n        <span>Registered Private Limited Company<\u002Fspan>\n        <span>Government-registered Importer-Exporter (valid IEC held)<\u002Fspan>\n        <span>CIN: <span style=\"color:rgba(244,239,230,.88)\">U13999GJ2024PTC152828<\u002Fspan><\u002Fspan>\n        <span>GSTIN: <span style=\"color:rgba(244,239,230,.88)\">24AAICE2625C1Z5<\u002Fspan><\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"border-top:1px solid rgba(244,239,230,.12);padding:22px 0 30px;display:flex;gap:12px 28px;flex-wrap:wrap;justify-content:space-between;font-size:12.5px\">\n        <span>© {{ year }} Everbees Worldwide Private Limited. All rights reserved.<\u002Fspan>\n        <span>Surat, Gujarat, India &nbsp;·&nbsp; Import | Export | Global Sourcing | Logistics<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Ffooter>\n\n  <sc-if value=\"{{ floatingWhatsApp }}\" hint-placeholder-val=\"{{ true }}\">\n    <a href=\"https://wa.me/919099031705\" target=\"_blank\" rel=\"noopener\" aria-label=\"Chat on WhatsApp\" style=\"position:fixed;right:clamp(16px,2.5vw,32px);bottom:clamp(16px,2.5vw,32px);z-index:80;display:inline-flex;align-items:center;gap:12px;background:#1B7F35;color:#F4EFE6;padding:16px 24px;border-radius:999px;box-shadow:0 14px 36px rgba(0,0,0,.4);font-weight:600;font-size:14px;letter-spacing:0\" style-hover=\"background:#156A2B;color:#F4EFE6;transform:translateY(-2px)\">\n      <span style=\"width:10px;height:10px;border-radius:50%;background:#5CC754;animation:ebPulse 2.2s ease-out infinite;flex:none\"><\u002Fspan>\n      WhatsApp\n    <\u002Fa>\n  <\u002Fsc-if>\n<\u002Fdiv>\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;startPage&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;home&quot;,&quot;about&quot;,&quot;services&quot;,&quot;range&quot;,&quot;why&quot;,&quot;contact&quot;],&quot;default&quot;:&quot;home&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Preview&quot;},&quot;showTestimonials&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:false,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Sections&quot;},&quot;floatingWhatsApp&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Sections&quot;}}\">\nconst PAGES = [\"home\", \"about\", \"services\", \"range\", \"why\", \"contact\"];\nconst NAV = [\n  { key: \"home\", label: \"Home\" },\n  { key: \"about\", label: \"About\" },\n  { key: \"services\", label: \"Services\" },\n  { key: \"range\", label: \"Product Range\" },\n  { key: \"why\", label: \"Why Us\" },\n  { key: \"contact\", label: \"Contact\" }\n];\nconst WA = \"https://wa.me/919099031705\";\n\nconst TRUST = [\n  \"Registered Private Limited Company\",\n  \"Government-registered Importer-Exporter (valid IEC held)\",\n  \"GST-registered business\",\n  \"80+ shipments handled\",\n  \"Verified global supplier network\",\n  \"24/7 client support\"\n].map((label) => ({ label: label }));\n\nconst SERVICES = [\n  { n: \"01\", title: \"Import Services\", short: \"Sourcing, order placement, freight, customs clearance and delivery: the whole inbound process.\", body: \"Complete import solutions: supplier sourcing, order placement, freight booking, customs clearance and delivery. Full expertise across the entire import process.\" },\n  { n: \"02\", title: \"Export Services\", short: \"Sourcing, quality checks, export documentation, packing and freight for shipments leaving India.\", body: \"From product sourcing and quality checks to export documentation, packing and freight, we manage your outbound shipments from start to finish. With hands-on experience across both LCL and FCL cargo and a strong supplier base, we make exporting from India simple, compliant and cost-effective.\" },\n  { n: \"03\", title: \"LCL & FCL Shipments\", short: \"Less-than-container for smaller consignments, full container for bulk: chosen to keep costs low.\", body: \"Flexible container options: Less-than-Container-Load (LCL) for smaller consignments and Full-Container-Load (FCL) for bulk: chosen to keep your costs low.\" },\n  { n: \"04\", title: \"Freight & Logistics\", short: \"Cost-effective, well-coordinated sea freight for the safe, timely movement of your cargo.\", body: \"Cost-effective, well-coordinated freight forwarding by sea, ensuring safe and timely movement of your cargo.\" },\n  { n: \"05\", title: \"Customs Clearance & Documentation\", short: \"Accurate, compliant handling of every document and formality so shipments clear smoothly.\", body: \"Accurate, compliant handling of all import/export documentation and customs formalities, so shipments clear smoothly.\" },\n  { n: \"06\", title: \"Product Sourcing & Procurement\", short: \"Quality products from trusted global manufacturers, with the best possible price passed on to you.\", body: \"We source quality products from trusted global manufacturers and pass on the best possible price to you.\" }\n];\n\nconst CATEGORIES = [\n  { n: \"01\", title: \"Stationery & Office Supplies\", line: \"Everyday writing, paper and desk essentials for retail and institutional buyers.\" },\n  { n: \"02\", title: \"Art & Craft Materials\", line: \"Colour, drawing and craft supplies for schools, hobbyists and retailers.\" },\n  { n: \"03\", title: \"Adhesives & Industrial Glue\", line: \"General-purpose and industrial adhesives for home, workshop and trade.\" },\n  { n: \"04\", title: \"Decorative Glass & Mirror Products\", line: \"Premium decorative glass, mirrors and finished glass articles.\" },\n  { n: \"05\", title: \"Home, Gift & General Merchandise\", line: \"Household, gifting and general merchandise across a growing range.\" },\n  { n: \"06\", title: \"Custom Sourcing on Request\", line: \"Can't find it? We'll source it. Tell us the product, quantity and destination: our sourcing team will find it and quote the best landed price.\", custom: true }\n];\n\nconst NETWORK = [\n  \"Verified, factory-direct suppliers\",\n  \"Quality checked before every shipment\",\n  \"Competitive, transparent pricing\",\n  \"Any product sourced on request\",\n  \"Full import & export documentation\",\n  \"Supplied in both LCL & FCL quantities\"\n].map((label) => ({ label: label }));\n\nconst WHY = [\n  { n: \"01\", title: \"Best Price\", body: \"Competitive, transparent pricing. We work hard to give you the lowest possible cost.\" },\n  { n: \"02\", title: \"Best Quality\", body: \"Carefully sourced products that meet high quality standards.\" },\n  { n: \"03\", title: \"Proven Experience\", body: \"80+ import shipments successfully handled with a strong safety record.\" },\n  { n: \"04\", title: \"LCL & FCL Expertise\", body: \"Complete command over both LCL and FCL cargo movements.\" },\n  { n: \"05\", title: \"End-to-End Handling\", body: \"One partner for sourcing, freight, customs and delivery.\" },\n  { n: \"06\", title: \"24/7 Support\", body: \"A dedicated support team available round the clock.\" }\n];\n\nconst STATS = [\n  { to: 80, suffix: \"+\", title: \"Shipments handled\", sub: \"Successfully delivered across LCL & FCL cargo.\" },\n  { to: 88, suffix: \"+\", title: \"Happy clients\", sub: \"Trusted by businesses for quality and price.\" },\n  { to: 10, suffix: \"+\", title: \"Countries served\", sub: \"Sourcing and trading across global markets.\" },\n  { to: 24, suffix: \"/7\", title: \"Client support\", sub: \"Always available on phone and WhatsApp.\" }\n];\n\nconst TESTIMONIALS = [\n  { quote: \"Client testimonial to be added. Verified feedback from a recent import shipment will appear here.\", name: \"Client name\", meta: \"Company | City\" },\n  { quote: \"Client testimonial to be added. Verified feedback from an export consignment will appear here.\", name: \"Client name\", meta: \"Company | City\" },\n  { quote: \"Client testimonial to be added. Verified feedback from a sourcing project will appear here.\", name: \"Client name\", meta: \"Company | City\" }\n];\n\nconst PROCESS = [\n  { n: \"01\", title: \"Enquiry & quotation\", body: \"Share the product, quantity and destination. We revert with landed pricing and a shipping plan.\" },\n  { n: \"02\", title: \"Sourcing & quality check\", body: \"Factory-direct suppliers are shortlisted and goods are quality-checked before dispatch.\" },\n  { n: \"03\", title: \"Booking & documentation\", body: \"LCL or FCL space is booked and every import/export document is prepared accurately.\" },\n  { n: \"04\", title: \"Customs clearance\", body: \"Compliant clearance at JNCH, Hazira or ICD Surat, handled by our team.\" },\n  { n: \"05\", title: \"Delivery\", body: \"Cargo is delivered to your door, with full transparency at every step.\" }\n];\n\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.globeEl = null;\n    this.globeCtl = null;\n    this.setGlobe = (el) => this.mountGlobe(el);\n    let hash = typeof location !== \"undefined\" ? location.hash.replace(\"#\", \"\") : \"\";\n    if (hash === \"products\") hash = \"range\";\n    const start = PAGES.indexOf(hash) >= 0 ? hash : (PAGES.indexOf(props.startPage) >= 0 ? props.startPage : \"home\");\n    this.canAnimate = typeof document !== \"undefined\" && document.visibilityState === \"visible\" &&\n      !(typeof window !== \"undefined\" && window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches);\n    this.state = {\n      page: start,\n      menuOpen: false,\n      width: typeof window !== \"undefined\" ? window.innerWidth : 1280,\n      counts: this.canAnimate ? [0, 0, 0, 0] : STATS.map((s) => s.to),\n      counted: !this.canAnimate,\n      form: { name: \"\", phone: \"\", email: \"\", message: \"\", bot: \"\" },\n      formStatus: \"idle\"\n    };\n    this.statsEl = null;\n    this.setStatsEl = (el) => {\n      this.statsEl = el;\n      if (this.io) { this.io.disconnect(); this.io = null; }\n      if (el) this.observeStats();\n    };\n  }\n\n  componentDidMount() {\n    this.onResize = () => this.setState({ width: window.innerWidth });\n    window.addEventListener(\"resize\", this.onResize);\n    this.onHash = () => {\n      let h = location.hash.replace(\"#\", \"\");\n      if (h === \"products\") h = \"range\";\n      if (PAGES.indexOf(h) >= 0 && h !== this.state.page) this.go(h)();\n    };\n    window.addEventListener(\"hashchange\", this.onHash);\n    this.observeStats();\n  }\n\n  componentWillUnmount() {\n    window.removeEventListener(\"resize\", this.onResize);\n    window.removeEventListener(\"hashchange\", this.onHash);\n    if (this.io) this.io.disconnect();\n    if (this.raf) cancelAnimationFrame(this.raf);\n    if (this.settle) clearTimeout(this.settle);\n    this.mountGlobe(null);\n  }\n\n  mountGlobe(el) {\n    if (this.globeEl === el) return;\n    this.globeEl = el;\n    if (this.globeCtl) { this.globeCtl.destroy(); this.globeCtl = null; }\n    if (!el) return;\n    const RES = window.__resources || {};\n    if (!this.globeMod) this.globeMod = import(RES.globeJs || new URL(\"globe.js\", document.baseURI).href);\n    this.globeMod.then((m) => {\n      if (this.globeEl !== el || !el.isConnected) return;\n      const reduce = window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n      const U = (p) => new URL(p, document.baseURI).href;\n      this.globeCtl = m.createGlobe(el, {\n        textures: { day: RES.earthDay || U(\"assets/earth/day.jpg\"), night: RES.earthNight || U(\"assets/earth/night.jpg\"), ocean: RES.earthOcean || U(\"assets/earth/ocean.jpg\"), clouds: RES.earthClouds || U(\"assets/earth/clouds.jpg\") },\n        landUrl: RES.landDots || U(\"assets/land-dots.json\"), animate: !reduce\n      });\n    }).catch((e) => console.warn(\"[globe] failed to load\", e));\n  }\n\n  observeStats() {\n    if (!this.statsEl || this.state.counted || this.io) return;\n    if (typeof IntersectionObserver === \"undefined\") { this.runCounters(); return; }\n    this.io = new IntersectionObserver((entries) => {\n      if (entries.some((e) => e.isIntersecting)) {\n        this.io.disconnect();\n        this.io = null;\n        this.runCounters();\n      }\n    }, { threshold: 0.2 });\n    this.io.observe(this.statsEl);\n  }\n\n  runCounters() {\n    if (this.state.counted) return;\n    const dur = 1600, t0 = performance.now();\n    const at = (e) => STATS.map((s) => Math.round(s.to * e));\n    this.setState({ counted: true, counts: at(0) });\n    const tick = (now) => {\n      const p = Math.min(1, (now - t0) / dur);\n      this.setState({ counts: at(1 - Math.pow(1 - p, 3)) });\n      if (p < 1) this.raf = requestAnimationFrame(tick);\n    };\n    this.raf = requestAnimationFrame(tick);\n    this.settle = setTimeout(() => this.setState({ counts: at(1) }), dur + 120);\n  }\n\n  go(page) {\n    return (ev) => {\n      if (ev && ev.preventDefault) ev.preventDefault();\n      if (typeof history !== \"undefined\") history.replaceState(null, \"\", \"#\" + page);\n      this.setState({ page: page, menuOpen: false }, () => { window.scrollTo(0, 0); });\n    };\n  }\n\n  field(k) {\n    return (ev) => {\n      const v = ev.target.value;\n      this.setState((s) => ({ form: Object.assign({}, s.form, { [k]: v }) }));\n    };\n  }\n\n  enquiryText() {\n    const f = this.state.form;\n    return [\"Name: \" + (f.name || \"-\"), \"Phone: \" + (f.phone || \"-\"), \"E-mail: \" + (f.email || \"-\"), \"\", \"Message:\", f.message || \"-\"].join(\"\\n\");\n  }\n\n  openMail() {\n    const subj = \"Website enquiry: \" + (this.state.form.name || \"New enquiry\");\n    window.location.href = \"mailto:everbeesworldwide2406@gmail.com?subject=\" + encodeURIComponent(subj) + \"&body=\" + encodeURIComponent(this.enquiryText());\n  }\n\n  submit(ev) {\n    ev.preventDefault();\n    if (this.state.form.bot) return;\n    const f = this.state.form;\n    const body = new URLSearchParams({ \"form-name\": \"enquiry\", name: f.name, phone: f.phone, email: f.email, message: f.message }).toString();\n    this.setState({ formStatus: \"sending\" });\n    fetch(\"/\", { method: \"POST\", headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" }, body: body })\n      .then((r) => {\n        if (!r.ok) throw new Error(\"HTTP \" + r.status);\n        this.setState({ formStatus: \"sent\" });\n      })\n      .catch(() => {\n        this.setState({ formStatus: \"failed\" });\n        this.openMail();\n      });\n  }\n\n  renderVals() {\n    const s = this.state;\n    const isDesktop = s.width >= 1000;\n\n    const nav = NAV.map((n, i) => ({\n      label: n.label,\n      num: \"0\" + (i + 1),\n      href: \"#\" + n.key,\n      go: this.go(n.key),\n      color: s.page === n.key ? \"#F4EFE6\" : \"rgba(244,239,230,.68)\",\n      dot: s.page === n.key ? 1 : 0\n    }));\n\n    const stats = STATS.map((st, i) => ({ num: String(s.counts[i]), suffix: st.suffix, title: st.title, sub: st.sub }));\n\n    const categories = CATEGORIES.map((c) => ({\n      n: c.n,\n      title: c.title,\n      line: c.line,\n      bg: c.custom ? \"rgba(184,137,43,.14)\" : \"#101F45\",\n      border: c.custom ? \"rgba(224,180,90,.55)\" : \"rgba(244,239,230,.12)\",\n      wa: WA + \"?text=\" + encodeURIComponent(\"Hello Everbees Worldwide, I would like to enquire about \" + c.title + \".\")\n    }));\n\n    return {\n      nav: nav,\n      isDesktop: isDesktop,\n      isMobile: !isDesktop,\n      menuOpen: s.menuOpen && !isDesktop,\n      toggleMenu: () => this.setState((st) => ({ menuOpen: !st.menuOpen })),\n\n      isHome: s.page === \"home\",\n      isAbout: s.page === \"about\",\n      isServices: s.page === \"services\",\n      isRange: s.page === \"range\",\n      isWhy: s.page === \"why\",\n      isContact: s.page === \"contact\",\n\n      goHome: this.go(\"home\"),\n      goAbout: this.go(\"about\"),\n      goServices: this.go(\"services\"),\n      goRange: this.go(\"range\"),\n      goWhy: this.go(\"why\"),\n      goContact: this.go(\"contact\"),\n\n      trust: TRUST,\n      services: SERVICES,\n      categories: categories,\n      network: NETWORK,\n      why: WHY,\n      stats: stats,\n      statsRef: this.setStatsEl,\n      globeRef: this.setGlobe,\n      testimonials: TESTIMONIALS,\n      process: PROCESS,\n      year: String(new Date().getFullYear()),\n\n      form: s.form,\n      onName: this.field(\"name\"),\n      onPhone: this.field(\"phone\"),\n      onEmail: this.field(\"email\"),\n      onMessage: this.field(\"message\"),\n      onBot: this.field(\"bot\"),\n      submitEnquiry: (ev) => this.submit(ev),\n      sendWhatsapp: () => window.open(WA + \"?text=\" + encodeURIComponent(\"Enquiry from website\\n\\n\" + this.enquiryText()), \"_blank\"),\n      formSent: s.formStatus === \"sent\",\n      formOpen: s.formStatus !== \"sent\",\n      formSending: s.formStatus === \"sending\",\n      formFailed: s.formStatus === \"failed\",\n      submitLabel: s.formStatus === \"sending\" ? \"Sending…\" : \"Send Enquiry\",\n\n      showTestimonials: this.props.showTestimonials ?? true,\n      floatingWhatsApp: this.props.floatingWhatsApp ?? true\n    };\n  }\n}\n\n<\u002Fscript>\n\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>